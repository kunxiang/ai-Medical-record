{
  "name": "@amr/tools",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "provision-bucket": "tsx src/provision-bucket.ts",
    "seed-account": "tsx src/seed-account.ts",
    "gen-meta": "tsx src/gen-meta.ts",
    "rebuild-index": "tsx src/rebuild-index.ts",
    "verify-rebuild": "tsx src/verify-rebuild.ts",
    "m0:acceptance": "tsx src/m0-acceptance.ts",
    "ci:deps": "tsx src/ci-deps.ts",
    "gen-m1-fixtures": "tsx src/gen-m1-fixtures.ts",
    "regen-derivatives": "tsx src/regen-derivatives.ts",
    "m1:acceptance": "tsx src/m1-acceptance.ts",
    "m2:acceptance": "tsx src/m2-acceptance.ts",
    "scan-m2-pii": "node --import tsx src/scan-m2-pii.ts",
