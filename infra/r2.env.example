# Cloudflare R2 后端配置模板(ADR-048)。复制为 infra/r2.env 后填入凭证 —— 该文件已被 .gitignore 排除。
# 凭证**永远不进仓库**;.env / .env.local 已在 .gitignore 中。

S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=ai-medical-record
S3_REGION=auto                 # R2 必须是 auto;签名区域不匹配会直接 SignatureDoesNotMatch

# 运行时(应用)凭证:R2 API token,权限档 "Object Read & Write" 即可。
# 应用只用 Put/Get/Head/Copy/DeleteObject + ListObjectsV2,全是对象级操作。
S3_ACCESS_KEY=
S3_SECRET_KEY=

# provision-bucket 专用:配置 CORS / 生命周期需要 "Admin Read & Write"。
# 平时不要保留该档凭证 —— 配置完成后把 token 降回 Object Read & Write。
S3_ADMIN_KEY=
S3_ADMIN_SECRET=

# CORS 允许来源(逗号分隔)。改这一项需要 admin 档凭证并重跑 provision-bucket。
WEB_ORIGIN=https://medireco.eckstein.pro,http://localhost:5173
