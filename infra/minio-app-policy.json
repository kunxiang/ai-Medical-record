{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketOps",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketVersioning"],
      "Resource": ["arn:aws:s3:::medical-record"]
    },
    {
      "Sid": "ObjectRW",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:PutObjectRetention", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::medical-record/*"]
    },
    {
      "Sid": "TempDeleteOnly",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::medical-record/_incoming/*", "arn:aws:s3:::medical-record/_probe/*"]
    }
  ]
}
