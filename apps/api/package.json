    "@amr/storage": "workspace:*",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fastify/cors": "^10.1.0",
    "@fontsource/noto-sans-sc": "5.2.8",
    "@node-rs/argon2": "^2.0.2",
    "@pdf-lib/fontkit": "1.1.1",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
